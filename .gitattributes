# 统一换行与文本处理，避免跨平台产生无意义 diff。
* text=auto eol=lf

# 二进制资源不做换行转换。
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.gz binary
*.exe binary
*.dll binary
*.sys binary

# 合并策略。
Cargo.lock merge=union
package-lock.json merge=union
