{
  "name": "clay-mic",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "description": "Bluetooth remote voice input for Windows: BLE ATVV voice, local whisper.cpp transcription, and text injection.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "cargo build --manifest-path src-tauri/Cargo.toml --package clay-tap && RUST_LOG=info tauri dev",
    "build:tap": "cargo build --manifest-path src-tauri/Cargo.toml --package clay-tap",
    "build:tap:release": "cargo build --release --manifest-path src-tauri/Cargo.toml --package clay-tap",
    "build:keyslots:release": "cargo build --release --manifest-path src-tauri/Cargo.toml -p clay-mic-keyslots",
    "package": "node scripts/package.mjs",
    "package:copy": "node scripts/package.mjs --no-build",
    "caps": "cargo run --manifest-path src-tauri/Cargo.toml -- --generate-caps",
    "icons": "tauri icon src-tauri/icons/source.svg && node -e \"require('fs').copyFileSync('src-tauri/icons/32x32.png','src-tauri/icons/tray.png')\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml --workspace",
    "version:sync": "node scripts/sync-version.mjs",
    "changelog": "git-cliff --unreleased --prepend CHANGELOG.md",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "version": "node scripts/sync-version.mjs && git add src-tauri/tauri.conf.json src-tauri/Cargo.toml src-tauri/keyslots/Cargo.toml src-tauri/tap-dll/Cargo.toml src-tauri/Cargo.lock && npm run changelog && git add CHANGELOG.md"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.6.0",
    "@tauri-apps/plugin-global-shortcut": "^2.2.0",
    "@tauri-apps/plugin-store": "^2.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.6.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.3.0",
    "vitest": "^5.0.1"
  }
}
