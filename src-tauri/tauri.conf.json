{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clay-Mic",
  "mainBinaryName": "Clay-Mic",
  "version": "1.1.0",
  "identifier": "com.clay-mic.app",
  "build": {
    "beforeDevCommand": "npm run build:keyslots:release && npm run build:tap:release && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:tap:release && npm run build && npm run build:keyslots:release",
    "frontendDist": "../dist"
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "target/release/clay_tap.dll": "clay_tap.dll"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Clay-Mic",
        "width": 1040,
        "height": 760,
        "minWidth": 820,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "url": "index.html",
        "additionalBrowserArgs": "--disable-logging"
      },
      {
        "label": "overlay",
        "title": "Clay-Mic overlay",
        "width": 420,
        "height": 560,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "url": "index.html?window=overlay",
        "additionalBrowserArgs": "--disable-logging"
      },
      {
        "label": "indicator",
        "title": "Clay-Mic indicator",
        "width": 360,
        "height": 280,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "focus": false,
        "focusable": false,
        "center": true,
        "url": "index.html?window=indicator",
        "additionalBrowserArgs": "--disable-logging"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://* http://*; img-src 'self' asset: data: https:; style-src 'self' 'unsafe-inline'"
    }
  }
}
